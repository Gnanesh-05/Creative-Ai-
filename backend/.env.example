# Environment mode (development / production)
ENVIRONMENT=development
PROJECT_NAME="Creative AI API"
LOG_LEVEL=INFO

# FastAPI Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security & JWT
SECRET_KEY=super-secret-creative-ai-jwt-signing-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://creative_user:creative_pass@localhost:5432/creative_ai_db

# External AI Provider Keys (SERVER-SIDE ONLY - Never expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
IMAGE_GEN_API_KEY=your_image_provider_key_here
MUSIC_GEN_API_KEY=your_music_provider_key_here

# Storage Provider Settings (S3 / Cloud Storage / Local)
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=creative-ai-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email Provider Settings
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@creativeai.app
